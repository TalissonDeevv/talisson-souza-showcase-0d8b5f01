# Frontend variables. These are public by design because Vite exposes VITE_* to the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_COMMENTS_SUPABASE_URL=https://YOUR_COMMENTS_PROJECT_REF.supabase.co
VITE_COMMENTS_SUPABASE_PUBLISHABLE_KEY=YOUR_COMMENTS_SUPABASE_PUBLISHABLE_KEY
VITE_COMMENTS_SUPABASE_PROJECT_ID=YOUR_COMMENTS_PROJECT_REF

# Supabase Edge Function secrets. Configure these in Supabase, not in Vercel browser env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
CONTACT_CAPTCHA_SECRET=GENERATE_A_LONG_RANDOM_SECRET
CONTACT_RATE_LIMIT_SALT=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
DISCORD_RATE_LIMIT_SALT=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID
DISCORD_READER_ROLE_ID=YOUR_DISCORD_READER_ROLE_ID
ALLOWED_ORIGINS=https://talissonsouza.com.br,https://www.talissonsouza.com.br,http://localhost:8080,http://127.0.0.1:8080
